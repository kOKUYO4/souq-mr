# ─────────────────────────────────────────────────────────────────────────────
# SOUQ.MR — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne JAMAIS committer .env.local sur git
# ─────────────────────────────────────────────────────────────────────────────

# ── Sécurité JWT (OBLIGATOIRE en prod) ──────────────────────────────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_64_caracteres_minimum

# ── Twilio SMS (OBLIGATOIRE en prod) ────────────────────────────────────────
# Compte Twilio : https://console.twilio.com
# Supports numéros +222 (Mauritanie) via SMS international
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Supabase (OBLIGATOIRE) ──────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://kbnrmhevyyowuaavxqip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  ← copier depuis Supabase
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...      ← Settings > API > service_role (garder secret)

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://souq.mr
NODE_ENV=production
