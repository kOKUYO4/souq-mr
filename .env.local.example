# ─────────────────────────────────────────────────────────────────────────────
# SOUQ.MR — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne JAMAIS committer .env.local sur git
# ─────────────────────────────────────────────────────────────────────────────

# ── Sécurité JWT (OBLIGATOIRE en prod) ──────────────────────────────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer_par_une_chaine_aleatoire_de_64_caracteres_minimum

# ── Twilio SMS (OBLIGATOIRE en prod) ────────────────────────────────────────
# Compte Twilio : https://console.twilio.com
# Supports numéros +222 (Mauritanie) via SMS international
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://souq.mr
NODE_ENV=production
